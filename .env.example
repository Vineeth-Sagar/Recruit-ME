# Copy to .env and adjust. .env is git-ignored.
#
# The defaults below are wired for `docker compose up` and are SAFE FOR LOCAL DEV
# ONLY — dev mode mints an ephemeral JWT keypair and uses an all-zero credential
# key. A real deployment MUST set ENV=prod and fill in every value marked (prod).

# ─── app ────────────────────────────────────────────────
ENV=dev                          # dev | test | prod
FRONTEND_BASE_URL=http://localhost:3000
# (prod) RS256 keypair as PEM. Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Paste the PEM contents with literal \n for newlines, or mount files and point here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── db ─────────────────────────────────────────────────
# compose overrides host/port to `postgres:5432`; this value is for host tools.
DATABASE_URL=postgresql+asyncpg://recruit:recruit@localhost:15432/recruit

# ─── redis (queue, rate-limit buckets, locks) ───────────
REDIS_URL=redis://localhost:16379/0

# ─── objstore (MinIO locally, S3 in prod) ───────────────
S3_ENDPOINT=http://localhost:19000
S3_BUCKET=recruit
S3_ACCESS_KEY=recruit
S3_SECRET_KEY=recruit-secret
S3_REGION=us-east-1

# ─── crypto (site-credential encryption, Phase 4.6) ─────
# (prod) 32 random bytes, base64. Generate:
#   uv run python -c "from recruit_api.security.crypto import generate_master_key_b64 as g; print(g())"
# For key rotation use CREDENTIAL_MASTER_KEYS="1:<b64>,2:<b64>" and bump the version.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_MASTER_KEYS=
CREDENTIAL_KEY_VERSION=1

# ─── email ──────────────────────────────────────────────
# console: writes the message to the service log (the local "mail sandbox").
# resend:  real delivery; needs RESEND_API_KEY and a verified EMAIL_FROM domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Recruit-ME <noreply@example.com>

# ─── llm (engine résumé parse + job matching) ───────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ─── scraping policy ────────────────────────────────────
# LinkedIn / Indeed / Glassdoor stay off unless a profile opts in AND this is true.
BIG3_ENABLED_GLOBAL=false
# HTTP_PROXY_URL=http://user:pass@proxy.example:3128

# ─── frontend ───────────────────────────────────────────
# Browser calls /api/* on the web origin; the Next server proxies to the API.
# In compose this is set to http://api:8000 automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
