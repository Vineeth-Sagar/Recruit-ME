# Copy to .env and fill in. .env is git-ignored.
# Phase 4.1 only needs the infra block; the rest is here so the shape is settled.

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://recruit:recruit@localhost:15432/recruit

# ─── Redis (queue, rate-limit buckets, locks) ────────────
REDIS_URL=redis://localhost:16379/0

# ─── Object storage (MinIO locally, S3 in prod) ──────────
S3_ENDPOINT=http://localhost:19000
S3_BUCKET=recruit
S3_ACCESS_KEY=recruit
S3_SECRET_KEY=recruit-secret
S3_REGION=us-east-1

# ─── LLM (engine résumé parse + job matching) ────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ─── Auth (Phase 4.2) ───────────────────────────────────
# Generate an RS256 keypair; paste PEM contents (newlines as \n) or point to files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── Email (Phase 4.4) ──────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Recruit-ME <noreply@example.com>

# ─── Credential encryption (Phase 4.6) ──────────────────
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_VERSION=1

# ─── Scraping policy ────────────────────────────────────
# LinkedIn/Indeed/Glassdoor stay off unless a profile opts in AND this is true.
BIG3_ENABLED_GLOBAL=false
# HTTP_PROXY_URL=

# ─── Frontend (Phase 4.2) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
